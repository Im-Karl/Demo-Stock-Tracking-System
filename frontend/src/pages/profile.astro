---
import Layout from '../layouts/Layout.astro';
import PageTitle from '../components/common/PageTitle.astro';
import UserProfileWrapper from '../components/user/UserProfileWrapper.jsx';
---

<Layout title="Hồ sơ cá nhân">
  <main class="relative min-h-screen pt-10 pb-20">
    <div class="relative container mx-auto px-4">
      <PageTitle
        title="Quản lý hồ sơ"
        breadcrumbs={[
          { label: 'Trang chủ', href: '/' },
          { label: 'Hồ sơ cá nhân' },
        ]}
      />

      <UserProfileWrapper client:only="react" />
    </div>
  </main>
</Layout>
