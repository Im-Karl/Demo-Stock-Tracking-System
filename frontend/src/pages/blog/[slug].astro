---
import Layout from '../../layouts/Layout.astro';
import PageTitle from '../../components/common/PageTitle.astro';
import BlogDetail from '../../components/blog/BlogDetail.jsx';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');
---

<Layout title="Chi tiết bài viết">
  <main class="relative z-10 max-w-6xl mx-auto px-6 pt-10 pb-20">
    <PageTitle
      breadcrumbs={[
        { label: 'Trang chủ', href: '/' },
        { label: 'Cộng đồng', href: '/blog' },
        { label: 'Bài viết' },
      ]}
    />

    <BlogDetail slug={slug} client:only="react" />
  </main>
</Layout>