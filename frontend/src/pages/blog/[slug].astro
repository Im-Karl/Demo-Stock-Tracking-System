---
import Layout from '../../layouts/Layout.astro';
import BlogDetail from '../../components/blog/BlogDetail.jsx';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');
---

<Layout title="Chi tiết bài viết">
  <section
    class="relative min-h-screen bg-neutral-50 dark:bg-neutral-900
           text-slate-800 dark:text-slate-100 overflow-hidden"
  > 
    <div class="absolute inset-0 pointer-events-none">
      <!-- <div class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px]
                  bg-blue-500/20 blur-[120px] rounded-full"></div>
      <div class="absolute bottom-[-10%] left-[-10%] w-[500px] h-[500px]
                  bg-violet-500/20 blur-[120px] rounded-full"></div> -->
    </div>

    <main class="relative z-10 max-w-6xl mx-auto px-6 pt-10 pb-20">
      <BlogDetail slug={slug} client:only="react" />
    </main>
  </section>
</Layout>
