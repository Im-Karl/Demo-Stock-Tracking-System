---
import Layout from '../../layouts/Layout.astro';
import PageTitle from '../../components/common/PageTitle.astro';
import BlogEditor from '../../components/blog/BlogEditor.jsx';
---

<Layout title="Viết bài mới">
  <main class="relative z-10 max-w-6xl mx-auto px-6 py-16">
    <PageTitle
      title="Soạn thảo bài viết"
      breadcrumbs={[
        { label: 'Trang chủ', href: '/' },
        { label: 'Cộng đồng', href: '/blog' },
        { label: 'Viết bài mới' },
      ]}
    />

    <BlogEditor client:only="react" />
  </main>
</Layout>