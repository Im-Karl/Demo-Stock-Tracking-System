---
import Layout from '../../../layouts/Layout.astro';
import PageTitle from '../../../components/common/PageTitle.astro';
import EditBlogForm from '../../../components/blog/EditBlogForm.jsx';

const { id } = Astro.params;
---

<Layout title="Chỉnh sửa bài viết">
  <main class="relative min-h-screen pt-10 pb-20">
    <div class="relative container mx-auto px-4 max-w-6xl">
      <PageTitle
        title="Chỉnh sửa bài viết"
        breadcrumbs={[
          { label: 'Trang chủ', href: '/' },
          { label: 'Cộng đồng', href: '/blog' },
          { label: 'Quản lý', href: '/blog/manage' },
          { label: 'Chỉnh sửa' },
        ]}
      />

      <EditBlogForm blogId={id} client:only="react" />
    </div>
  </main>
</Layout>