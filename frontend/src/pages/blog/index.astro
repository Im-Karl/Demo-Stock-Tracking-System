---
import Layout from "../../layouts/Layout.astro";
import { blogService } from "../../services/blogService";

let blogs = [];
let errorMessage = null;

try {
  console.log("--> Đang gọi API lấy danh sách blog từ Server Astro...");
  const { data } = await blogService.getAll();
  blogs = data;
  console.log(`--> Lấy thành công ${blogs.length} bài viết.`);
}catch (err) {
  if (err instanceof Error) {
    console.error("--> Lỗi FETCH BLOG tại Server:", err.message);

    if ((err as any).code === "ECONNREFUSED") {
      errorMessage =
        "Không kết nối được Backend (Port 3000). Hãy kiểm tra xem server API đã bật chưa.";
    } else {
      errorMessage = "Lỗi tải dữ liệu: " + err.message;
    }
  } else {
    console.error("--> Lỗi không xác định:", err);
    errorMessage = "Đã xảy ra lỗi không xác định.";
  }
}
---

<Layout title="Danh sách Blog">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8 text-center">Góc Phân Tích</h1>

    {/* Hiển thị lỗi ra màn hình nếu có */}
    {errorMessage && (
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-center">
            <strong>Lỗi:</strong> {errorMessage}
        </div>
    )}

    {/* Hiển thị danh sách */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {blogs.map((blog: any) => (
        <a href={`/blog/${blog.slug}`} class="block group">
           <div class="bg-white p-6 rounded-lg shadow hover:shadow-lg transition border border-gray-100 h-full flex flex-col">
             <h2 class="text-xl font-bold text-gray-800 group-hover:text-blue-600 mb-2 line-clamp-2">
               {blog.title}
             </h2>
             <p class="text-gray-500 text-sm mb-4">
               Tác giả: <span class="font-semibold">{blog.author || "Ẩn danh"}</span>
               <br />
               {blog.publishedDate ? new Date(blog.publishedDate).toLocaleDateString("vi-VN") : "Nháp"}
             </p>
             {/* <p class="text-gray-600 line-clamp-3 text-sm flex-1">
                 {blog.content ? blog.content.substring(0, 150) : ""}...
             </p> */}
           </div>
        </a>
      ))}
    </div>

    {/* Nếu không có bài viết và không có lỗi */}
    {!errorMessage && blogs.length === 0 && (
      <div class="text-center py-20">
        <p class="text-gray-500 text-lg mb-4">Chưa có bài viết công khai nào.</p>
        <p class="text-sm text-gray-400">(Lưu ý: Trang chủ chỉ hiện bài Public. Hãy đăng nhập và vào trang quản lý để thấy bài riêng tư)</p>
      </div>
    )}
  </main>
</Layout>