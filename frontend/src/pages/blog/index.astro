---
import Layout from "../../layouts/Layout.astro";
import { blogService } from "../../services/blogService";

let blogs = [];
let errorMessage = null;

try {
  console.log("--> Đang gọi API lấy danh sách blog từ Server Astro...");
  const { data } = await blogService.getAll();
  blogs = data;
  console.log(`--> Lấy thành công ${blogs.length} bài viết.`);
} catch (err) {
  if (err instanceof Error) {
    console.error("--> Lỗi FETCH BLOG tại Server:", err.message);

    if ((err as any).code === "ECONNREFUSED") {
      errorMessage =
        "Không kết nối được Backend (Port 3000). Hãy kiểm tra xem server API đã bật chưa.";
    } else {
      errorMessage = "Lỗi tải dữ liệu: " + err.message;
    }
  } else {
    console.error("--> Lỗi không xác định:", err);
    errorMessage = "Đã xảy ra lỗi không xác định.";
  }
}
---

<Layout title="Danh sách Blog">
  <section
    class="relative min-h-screen bg-slate-50 dark:bg-[#0f172a]
           text-slate-800 dark:text-slate-100 overflow-hidden"
  >
    <!-- Ambient light -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px]
                  bg-blue-500/20 blur-[120px] rounded-full"></div>
      <div class="absolute bottom-[-10%] left-[-10%] w-[500px] h-[500px]
                  bg-violet-500/20 blur-[120px] rounded-full"></div>
    </div>

    <main class="relative z-10 max-w-7xl mx-auto px-6 py-16">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-12 text-center">
        Góc Phân Tích
        <span class="block mt-3 text-lg font-medium
                     text-slate-600 dark:text-slate-400">
          Góc nhìn thị trường & chia sẻ từ cộng đồng đầu tư
        </span>
      </h1>

      {/* ERROR */}
      {
        errorMessage && (
          <div
            class="mb-8 rounded-xl border border-red-300 dark:border-red-500/30
                   bg-red-50 dark:bg-red-500/10
                   text-red-700 dark:text-red-400
                   px-6 py-4 text-center"
          >
            <strong class="font-bold"> Lỗi:</strong> {errorMessage}
          </div>
        )
      }

      {/* BLOG GRID */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          blogs.map((blog: any) => (
            <div
  class="group h-full p-6 rounded-2xl
         bg-white/60 dark:bg-slate-800/60 backdrop-blur-xl
         border border-slate-200 dark:border-slate-700
         shadow-lg hover:shadow-2xl
         transition-all hover:-translate-y-1
         flex flex-col"
>

  <a href={`/blog/${blog.slug}`}>
    <h2
      class="text-xl font-bold mb-3 line-clamp-2
             text-slate-800 dark:text-slate-100
             group-hover:text-blue-600 dark:group-hover:text-blue-400
             transition"
    >
      {blog.title}
    </h2>
  </a>

  <p class="text-sm mb-4 leading-relaxed
           text-slate-600 dark:text-slate-400">
    Tác giả:
    <a 
      href={`/author/${blog.author._id}`} 
      class="ml-1 font-semibold text-blue-600 dark:text-blue-400 hover:underline transition"
    >
      {blog.author.displayName || blog.author.username}
    </a>
    <br />
    <span class="text-xs text-slate-500 dark:text-slate-500">
      {blog.publishedDate
        ? new Date(blog.publishedDate).toLocaleDateString("vi-VN")
        : "Nháp"}
    </span>
  </p>
</div>
          ))
        }
      </div>

      {/* EMPTY STATE */}
      {
        !errorMessage && blogs.length === 0 && (
          <div class="text-center py-24">
            <p class="text-lg font-medium text-slate-600 dark:text-slate-400 mb-4">
              Chưa có bài viết công khai nào
            </p>
            <p class="text-sm text-slate-500 dark:text-slate-500">
              Trang chủ chỉ hiển thị bài Public.  
              Hãy đăng nhập để xem bài riêng tư.
            </p>
          </div>
        )
      }
    </main>
  </section>
</Layout>
