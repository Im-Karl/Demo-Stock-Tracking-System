---
import Layout from "../../layouts/Layout.astro";
import PageTitle from "../../components/common/PageTitle.astro";
import BlogList from "../../components/blog/BlogList.jsx";

const searchParams = Astro.url.searchParams;
const keyword = searchParams.get("search") || "";
const page = parseInt(searchParams.get("page") || "1");

let blogs = [];
let totalPages = 1;
let currentPage = 1;
let errorMessage = null;

try {
  const apiUrl = `http://localhost:3000/api/blogs?keyword=${encodeURIComponent(keyword)}&page=${page}&limit=9`;
  const res = await fetch(apiUrl);
  if (!res.ok) throw new Error("Lỗi kết nối Backend");
  
  const data = await res.json();
  blogs = data.blogs || [];
  totalPages = data.totalPages || 1;
  currentPage = data.currentPage || 1;
} catch (err: any) {
  errorMessage = "Không thể tải danh sách bài viết: " + err.message;
}
---

<Layout title="Cộng đồng">
  <main class="relative min-h-screen pt-10 pb-20">
    <div class="relative container mx-auto px-4">

      <PageTitle
        title="Góc Phân Tích"
        breadcrumbs={[
          { label: 'Trang chủ', href: '/' },
          { label: 'Cộng đồng' },
        ]}
      />

      <BlogList
        blogs={blogs}
        totalPages={totalPages}
        currentPage={currentPage}
        keyword={keyword}
        errorMessage={errorMessage}
        client:load
      />

    </div>
  </main>
</Layout>