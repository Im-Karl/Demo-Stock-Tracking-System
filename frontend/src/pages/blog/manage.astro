---
import Layout from '../../layouts/Layout.astro';
import PageTitle from '../../components/common/PageTitle.astro';
import BlogManager from '../../components/blog/BlogManager.jsx';
---

<Layout title="Quản lý bài viết">
  <main class="relative min-h-screen pt-10 pb-20">
    <div class="relative container mx-auto px-4 max-w-5xl">
      <PageTitle
        title="Quản lý bài viết"
        breadcrumbs={[
          { label: 'Trang chủ', href: '/' },
          { label: 'Cộng đồng', href: '/blog' },
          { label: 'Quản lý bài viết' },
        ]}
      />

      <BlogManager client:only="react" />
    </div>
  </main>
</Layout>