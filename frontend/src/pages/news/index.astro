---
import Layout from '../../layouts/Layout.astro';
// Import NewsFeed (đã có sẵn Provider bên trong)
import NewsFeed from '../../components/dashboard/NewsFeed.jsx'; 
---

<Layout title="Tin tức 24h">
  <main class="container mx-auto px-4 py-8">
    <header class="mb-8 border-b pb-4">
      <h1 class="text-3xl font-bold text-gray-900">Tin Tức Tài Chính</h1>
      <p class="text-gray-500 mt-1">Tổng hợp tự động từ các nguồn uy tín nhất Việt Nam</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {/* Cột chính: Danh sách tin */}
      <div class="lg:col-span-2">
        
        {/* QUAN TRỌNG: Chỉ cần gọi NewsFeed với client:only="react" */}
        {/* KHÔNG bọc QueryWrapper ở đây nữa */}
        <NewsFeed client:only="react" />

      </div>

      {/* Cột phụ (Sidebar) */}
      <aside class="space-y-6">
        <div class="bg-white p-6 rounded-lg shadow border border-gray-100">
           <h3 class="font-bold text-lg mb-4">Xu hướng tìm kiếm</h3>
           <div class="flex flex-wrap gap-2">
             <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-600">#Vietcombank</span>
             <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-600">#Lãi suất</span>
             <span class="px-3 py-1 bg-gray-100 rounded-full text-sm text-gray-600">#Vàng SJC</span>
           </div>
        </div>
      </aside>
    </div>
  </main>
</Layout>