---
import Layout from '../../layouts/Layout.astro';
import NewsFeedWrapper from '../../components/dashboard/NewsFeedWrapper.jsx';
---

<Layout title="Tin tức 24h">
  <main class="relative min-h-screen pt-10 pb-20">

    <div class="relative container mx-auto px-4 max-w-5xl">

      <!-- HEADER -->
      <header class="mb-10 pb-6">
        <h1 class="text-4xl md:text-5xl font-extrabold text-grey-900 dark:text-grey-50 font-heading">
          Tin Tức
          <span class="text-primary-500">
            Tài Chính
          </span>
        </h1>

        <p class="mt-3 text-grey-600 dark:text-grey-400 max-w-2xl">
          Cập nhật liên tục từ các nguồn uy tín trong nước và quốc tế
        </p>
      </header>

      <!-- MAIN CONTENT -->
      <NewsFeedWrapper client:load />

    </div>
  </main>
</Layout>
