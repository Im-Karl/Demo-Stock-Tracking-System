---
import Layout from '../../layouts/Layout.astro';
import PageTitle from '../../components/common/PageTitle.astro';
import NewsFeedWrapper from '../../components/dashboard/NewsFeedWrapper.jsx';
---

<Layout title="Tin tức 24h">
  <main class="relative min-h-screen pt-10 pb-20">

    <div class="relative container mx-auto px-4 max-w-5xl">

      <PageTitle
        title="Tin Tức Tài Chính"
        breadcrumbs={[
          { label: 'Trang chủ', href: '/' },
          { label: 'Tin tức' },
        ]}
      />

      <!-- MAIN CONTENT -->
      <NewsFeedWrapper client:load />

    </div>
  </main>
</Layout>
