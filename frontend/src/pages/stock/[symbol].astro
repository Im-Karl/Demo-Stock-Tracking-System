---
import Layout from "../../layouts/Layout.astro";
import StockDetailClient from "../../components/stock/StockDetailClient.jsx";
import StockNewsClient from "../../components/stock/StockNewsClient.jsx";
import StockHeader from "../../components/stock/StockHeader.jsx";
import PageTitle from "../../components/common/PageTitle.astro";

import { QueryClient, QueryClientProvider } from "@tanstack/react-query";

const queryClient = new QueryClient();

const { symbol } = Astro.params as { symbol: string };

let companyInfo = null;
let error = null;

try {
  const infoRes = await fetch(`http://localhost:5000/api/stock/${symbol}`);
  if (infoRes.ok) {
    companyInfo = await infoRes.json();
  } else {
    error = "Không tìm thấy mã cổ phiếu này";
  }
} catch (err) {
  console.error(err);
  error = "Lỗi kết nối Server";
}

if (error || !companyInfo) {
  return Astro.redirect("/404");
}
---

<Layout title={`${symbol} - ${companyInfo.organ_name_vi}`}>
  <main class="min-h-screen pb-20 pt-10">
    <div class="container mx-auto px-4 max-w-6xl relative z-10">
      
      <!-- BREADCRUMBS & TITLE -->
      <PageTitle 
        title={`${symbol} — ${companyInfo.organ_name_vi}`}
        breadcrumbs={[
          { label: 'Trang chủ', href: '/' },
          { label: 'Thị trường', href: '/stock' },
          { label: symbol },
        ]}
      />

      <!-- INFO SECTION (Cardless Header) -->
      <StockHeader symbol={symbol} companyInfo={companyInfo} client:load />

      <!-- MAIN GRID -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- LEFT: Market Details & Charts -->
        <div class="lg:col-span-2 space-y-12">
          <StockDetailClient symbol={symbol} client:load />
        </div>

        <!-- RIGHT: Side Panel (News & Clock) -->
        <div class="space-y-10">
          
          {/* YouTube & Clock Section (Cardless Style) */}
          {companyInfo.latestVideoId && (
            <div class="space-y-4">
              <div class="flex items-end justify-between border-b border-grey-200 dark:border-grey-800 pb-3">
                <h3 class="font-bold text-lg text-grey-800 dark:text-grey-200 uppercase tracking-tight">
                  Hoạt động nổi bật
                </h3>

                <div class="text-right">
                  <div class="text-[10px] font-black uppercase text-grey-400 tracking-widest mb-1">Thanh Khoản (VN)</div>
                  <div
                    id="vn-clock"
                    class="text-2xl font-mono font-black tracking-tighter text-primary-600 dark:text-primary-400"
                  >
                    --:--:--
                  </div>
                </div>
              </div>

              <div class="relative aspect-video overflow-hidden bg-black rounded-sm shadow-inner group">
                <iframe
                  class="w-full h-full opacity-90 group-hover:opacity-100 transition-opacity"
                  src={`https://www.youtube.com/embed/${companyInfo.latestVideoId}?rel=0`}
                  frameborder="0"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          )}

          {/* News Feed Section */}
          <div class="space-y-4">
            <h3 class="font-bold text-lg text-grey-800 dark:text-grey-200 border-b border-grey-200 dark:border-grey-800 pb-3 uppercase tracking-tight">
              Tin tức {symbol}
            </h3>
            <StockNewsClient symbol={symbol} client:load hasVideo={!!companyInfo.latestVideoId} />
          </div>

        </div>
      </div>
    </div>
  </main>
    </div>
  </main>
</Layout>

<script is:inline>
  function updateVNClock() {
    const now = new Date();
    const vnTime = new Date(
      now.toLocaleString("en-US", { timeZone: "Asia/Ho_Chi_Minh" })
    );

    const hh = String(vnTime.getHours()).padStart(2, "0");
    const mm = String(vnTime.getMinutes()).padStart(2, "0");
    const ss = String(vnTime.getSeconds()).padStart(2, "0");

    const el = document.getElementById("vn-clock");
    if (el) el.textContent = `${hh}:${mm}:${ss}`;
  }

  updateVNClock();
  setInterval(updateVNClock, 1000);
</script>
