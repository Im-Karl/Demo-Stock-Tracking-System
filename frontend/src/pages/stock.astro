---
import Layout from '../layouts/Layout.astro';
import StockBoard from '../components/dashboard/StockBoard.jsx';
---

<Layout title="Thị trường">
  <main class="container mx-auto px-4 py-8">
    
    <div class="text-center mb-10">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-2">Thị Trường Ngân Hàng <span class="text-blue-600">Live</span></h1>
      <p class="text-gray-500">Cập nhật chỉ số realtime từ các sàn giao dịch</p>
    </div>

    {/* Bảng giá */}
    <div class="mb-12">
      <StockBoard client:load />
    </div>

    {/* Banner quảng cáo tính năng */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-blue-600 text-white p-8 rounded-2xl shadow-lg">
        <h2 class="text-2xl font-bold mb-2">📰 Tin Tức Tổng Hợp</h2>
        <p class="mb-4 text-blue-100">Cập nhật tin tức nóng hổi từ CafeF, VnExpress tự động.</p>
        <a href="/news" class="inline-block bg-white text-blue-600 px-6 py-2 rounded-full font-bold hover:bg-gray-100 transition">
          Xem tin tức →
        </a>
      </div>
      <div class="bg-indigo-600 text-white p-8 rounded-2xl shadow-lg">
        <h2 class="text-2xl font-bold mb-2">✍️ Cộng Đồng Nhà Đầu Tư</h2>
        <p class="mb-4 text-indigo-100">Đọc các bài phân tích chuyên sâu hoặc chia sẻ góc nhìn của bạn.</p>
        <a href="/blog" class="inline-block bg-white text-indigo-600 px-6 py-2 rounded-full font-bold hover:bg-gray-100 transition">
          Vào cộng đồng →
        </a>
      </div>
    </div>

  </main>
</Layout>