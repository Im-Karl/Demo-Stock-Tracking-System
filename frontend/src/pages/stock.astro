---
import Layout from '../layouts/Layout.astro';
import StockBoard from '../components/dashboard/StockBoard.jsx';
---

<Layout title="Thị trường">
  <main
    class="relative min-h-screen
           bg-slate-50 dark:bg-[#0f172a]
           text-slate-900 dark:text-slate-100
           overflow-hidden"
  >

    <!-- AMBIENT LIGHT (GIỐNG HOME HERO) -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-[-10%] right-[-10%] w-[400px] h-[400px] bg-blue-500/20 blur-[120px] rounded-full" />
      <div class="absolute bottom-[-10%] left-[-10%] w-[400px] h-[400px] bg-violet-500/20 blur-[120px] rounded-full" />
    </div>

    <div class="relative container mx-auto px-4 py-10">

      <!-- HEADER -->
      <div class="text-center mb-12">
        <h1
          class="text-4xl md:text-5xl font-extrabold mb-3
                 text-slate-900 dark:text-slate-100"
        >
          Thị Trường Ngân Hàng
          <span class="text-transparent bg-clip-text
                       bg-gradient-to-r
                       from-blue-600 to-violet-600
                       dark:from-blue-400 dark:to-violet-400">
            Live
          </span>
        </h1>

        <p class="text-slate-600 dark:text-slate-400 max-w-xl mx-auto">
          Cập nhật chỉ số realtime từ các sàn giao dịch
        </p>
      </div>

      <!-- BẢNG GIÁ -->
      <div class="mb-14">
        <StockBoard client:load />
      </div>

      <!-- BANNER TÍNH NĂNG -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- NEWS -->
        <div
          class="p-8 rounded-2xl transition-all
                 bg-white/70 dark:bg-slate-800/50
                 backdrop-blur-xl
                 border border-slate-200 dark:border-blue-500/30
                 shadow-xl"
        >
          <h2 class="text-2xl font-bold mb-2">
             Tin Tức Tổng Hợp
          </h2>

          <p class="mb-5 text-slate-600 dark:text-slate-400">
            Cập nhật tin tức nóng hổi từ CafeF, VnExpress tự động.
          </p>

          <a
            href="/news"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold transition
                   bg-gradient-to-r from-blue-600 to-violet-600
                   text-white shadow-lg shadow-blue-500/30
                   hover:from-blue-500 hover:to-violet-500"
          >
            Xem tin tức →
          </a>
        </div>

        <!-- COMMUNITY -->
        <div
          class="p-8 rounded-2xl transition-all
                 bg-white/70 dark:bg-slate-800/50
                 backdrop-blur-xl
                 border border-slate-200 dark:border-violet-500/30
                 shadow-xl"
        >
          <h2 class="text-2xl font-bold mb-2">
            Cộng Đồng Nhà Đầu Tư
          </h2>

          <p class="mb-5 text-slate-600 dark:text-slate-400">
            Đọc các bài phân tích chuyên sâu hoặc chia sẻ góc nhìn của bạn.
          </p>

          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold transition
                   bg-gradient-to-r from-emerald-500 to-teal-500
                   text-white shadow-lg shadow-emerald-500/30
                   hover:from-emerald-400 hover:to-teal-400"
          >
            Vào cộng đồng →
          </a>
        </div>

      </div>

    </div>
  </main>
</Layout>
