---
import Layout from '../layouts/Layout.astro';
import StockBoard from '../components/dashboard/StockBoard.jsx';
---

<Layout title="Thị trường">
  <main class="relative min-h-screen pt-10 pb-20">

    <div class="relative container mx-auto px-4">

      <!-- HEADER -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-3 text-grey-900 dark:text-grey-50 font-heading">
          Thị Trường Ngân Hàng
          <span class="text-primary-500">
            Live
          </span>
        </h1>

        <p class="text-grey-600 dark:text-grey-400 max-w-xl mx-auto">
          Cập nhật chỉ số realtime từ các sàn giao dịch
        </p>
      </div>

      <!-- BẢNG GIÁ -->
      <div class="mb-14">
        <StockBoard client:load />
      </div>

      <!-- BANNER TÍNH NĂNG -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-16">

        <!-- NEWS -->
        <div class="p-8 rounded-sm bg-white dark:bg-grey-800 shadow-sm transition-shadow hover:shadow-md">
          <h2 class="text-2xl font-bold mb-2 text-grey-900 dark:text-grey-100 font-heading">
             Tin Tức Tổng Hợp
          </h2>

          <p class="mb-6 text-grey-600 dark:text-grey-400">
            Cập nhật tin tức nóng hổi từ CafeF, VnExpress tự động.
          </p>

          <a href="/news" class="inline-flex items-center gap-2 px-6 py-3 rounded-sm font-bold transition-colors bg-primary-500 text-white hover:bg-primary-600 shadow-sm">
            Xem tin tức →
          </a>
        </div>

        <!-- COMMUNITY -->
        <div class="p-8 rounded-sm bg-white dark:bg-grey-900 shadow-sm transition-shadow hover:shadow-md">
          <h2 class="text-2xl font-bold mb-2 text-grey-900 dark:text-grey-100 font-heading">
            Cộng Đồng Nhà Đầu Tư
          </h2>

          <p class="mb-6 text-grey-600 dark:text-grey-400">
            Đọc các bài phân tích chuyên sâu hoặc chia sẻ góc nhìn của bạn.
          </p>

          <a href="/blog" class="inline-flex items-center gap-2 px-6 py-3 rounded-sm font-bold transition-colors bg-secondary-500 text-white hover:bg-secondary-600 shadow-sm">
            Vào cộng đồng →
          </a>
        </div>

      </div>

    </div>
  </main>
</Layout>
