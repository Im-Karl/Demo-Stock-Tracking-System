---
import Layout from '../layouts/Layout.astro';
import PageTitle from '../components/common/PageTitle.astro';
import StockBoard from '../components/dashboard/StockBoard.jsx';
---

<Layout title="Thị trường">
  <main class="relative min-h-screen pt-10 pb-20">

    <div class="relative container mx-auto px-4">

      <PageTitle
        title="Thị Trường Ngân Hàng"
        breadcrumbs={[
          { label: 'Trang chủ', href: '/' },
          { label: 'Thị trường' },
        ]}
      />

      <!-- BẢNG GIÁ -->
      <div class="mb-14">
        <StockBoard client:load />
      </div>

    </div>
  </main>
</Layout>
