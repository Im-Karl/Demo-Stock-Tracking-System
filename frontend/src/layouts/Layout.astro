---
import "../styles/global.css";
import ToastProvider from '../components/ui/ToastProvider.jsx';
import Header from '../components/common/Header.jsx';
import Footer from '../components/common/Footer.astro';

const { title } = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - StockBank</title>
  </head>
  <body class="bg-slate-50 dark:bg-[#020617] min-h-screen flex flex-col font-sans text-slate-800 dark:text-slate-100">
    <ToastProvider client:idle />
    <Header client:load />

    <div class="flex-1">
      <slot />
    </div>

    <Footer />
    <script define:vars={{ pathname }}>
       const token = localStorage.getItem('token');
       
       const publicPages = ['/','/login', '/register', "/forgot-password"];

       if (!publicPages.includes(pathname) && !token) {
           window.location.href = '/login';
       }
    </script>
  </body>
</html>