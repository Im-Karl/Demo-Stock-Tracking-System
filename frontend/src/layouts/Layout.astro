---
import "../styles/global.css";
import Header from '../components/common/Header.jsx';
import Footer from '../components/common/Footer.astro';

const { title } = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - StockBank</title>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col font-sans text-gray-900">
    
    <Header client:load />

    <div class="flex-1">
      <slot />
    </div>

    <Footer />
    <script define:vars={{ pathname }}>
       // Script này chạy ở trình duyệt
       const token = localStorage.getItem('token');
       
       // Danh sách các trang được phép vào mà không cần login
       const publicPages = ['/login', '/register', "/forgot-password"];

       // Kiểm tra: Nếu trang hiện tại KHÔNG nằm trong publicPages
       // VÀ không có token
       if (!publicPages.includes(pathname) && !token) {
           // Lưu lại trang họ đang định vào để redirect lại sau (nếu muốn xịn xò)
           // localStorage.setItem('redirectAfterLogin', pathname);
           
           // Đá về trang Login
           window.location.href = '/login';
       }
    </script>
  </body>
</html>